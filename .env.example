# Ushbu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env fayli GitHub'ga yuklanmaydi (.gitignore ichida).

# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# https://console.anthropic.com dan olingan API kalit
ANTHROPIC_API_KEY=sk-ant-...

# Ixtiyoriy sozlamalar
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (past = tezroq va arzonroq)
CLAUDE_EFFORT=medium
# Har bir foydalanuvchi uchun eslab qolinadigan xabarlar soni
MAX_HISTORY=20
# Faqat shu Telegram ID'larga ruxsat (vergul bilan). Bo'sh qoldirilsa — hammaga ochiq.
ALLOWED_USERS=
